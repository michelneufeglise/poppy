{
  "name": "poppy",
  "version": "0.1.0",
  "private": true,
  "description": "A hand-drawn desk buddy for macOS that talks with your local Ollama models.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/michelneufeglise/poppy.git"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "cut-sheet": "python3 scripts/cut_sheet.py",
    "cut-sheet2": "cd scripts && python3 cut_sheet2.py",
    "cut-sheet-female": "cd scripts && python3 cut_sheet_female.py",
    "cut-blink-female": "cd scripts && python3 cut_blink_female.py",
    "cut-listening-female": "cd scripts && python3 cut_listening_female.py",
    "build-listener": "mkdir -p out && xcrun swiftc -O sidecar/listen.swift -o out/listen -Xlinker -sectcreate -Xlinker __TEXT -Xlinker __info_plist -Xlinker sidecar/listen-Info.plist",
    "searxng": "sh scripts/searxng.sh",
    "test": "vitest run",
    "cut-chat": "python3 scripts/cut_chat.py"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.2.3",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@mozilla/readability": "0.6.0",
    "linkedom": "0.18.13",
    "pdfjs-dist": "6.4.299",
    "zod": "4.6.7"
  }
}
